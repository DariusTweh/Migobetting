# TheRundown pre-match odds (server-only). Keep real keys out of Git.
THERUNDOWN_API_KEY=

# OpenAI Responses API evidence reasoning (server-only; never NEXT_PUBLIC_).
# Use a project-scoped key with a spending limit in the OpenAI Platform.
OPENAI_API_KEY=

# Optional default: gpt-6.1-sol (supports reasoning and structured output).
# To save more, try gpt-6-luna if supported by your project.
OPENAI_MODEL=gpt-6.1-sol

# REQUIRED to enable the AI endpoint. Choose your own long random passphrase
# (at least 16 characters). Enter that exact value in the MIGO AI panel.
# This is NOT your OpenAI API key.
MIGO_AI_ACCESS_TOKEN=
